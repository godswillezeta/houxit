{
  "name": "houxit",
  "version": "0.1.11",
  "description": "The blueprint for modern web apps.",
  "type": "module",
  "main": "dist/houxit.cjs",
  "module": "dist/houxit.esm.min.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/houxit.esm.js",
      "require": "./dist/houxit.cjs",
      "types": "./dist/index.d.ts"
    },
    "./runtime/controller": {
      "import": "./src/runtime/controller.js"
    }
  },
  "files": [
    "dist"
  ],
  "unpkg": "./dist/houxit.global.min.js",
  "jsdelivr": "./dist/houxit.global.min.js",
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "build:dev": "vite build --config vite.config.dev.js",
    "build:both":"npm run build && npm run build:dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/godswillezeta/houxit.git"
  },
  "keywords": [
    "houxit",
    "javascript-framework",
    "reactivity",
    "widgets"
  ],
  "author": "Houxit Systems",
  "license": "MIT",
  "dependencies": {
    "terser": "^5.49.0"
  }
}
